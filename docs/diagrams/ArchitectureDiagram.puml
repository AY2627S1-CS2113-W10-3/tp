@startuml
!pragma layout smetana
skinparam shadowing false
skinparam componentStyle rectangle

component "BudgetBite\n(Main)" as Main

package "UI" {
    [TextUi]
    [MenuNavigator]
}

package "Parser" {
    [Parser]
}

package "Commands" {
    [Command]
}

package "Model" {
    [ExpensesManager]
    [RatingsManager]
    [BudgetManager]
    [FoodDirectory]
}

package "Storage" {
    [StorageFile]
}

database "data/*.txt" as Files

Main -down-> [TextUi] : reads input,\nshows output
Main -down-> [MenuNavigator] : navigation input
Main -down-> [Parser] : parseCommand
Main -down-> [Command] : execute
Main -down-> [StorageFile] : load at start,\nsave after each command

[Parser] .right.> [Command] : creates
[Command] -down-> [ExpensesManager]
[Command] -down-> [RatingsManager]
[Command] -down-> [BudgetManager]
[MenuNavigator] -down-> [FoodDirectory]

[StorageFile] .up.> [ExpensesManager] : encodes/decodes
[StorageFile] .up.> [RatingsManager] : encodes/decodes
[StorageFile] .up.> [BudgetManager] : encodes/decodes
[StorageFile] -down-> Files : reads/writes
@enduml
