@startuml
' Model component: the classes that hold the user's data while the app runs.
skinparam shadowing false
skinparam classAttributeIconSize 0
skinparam defaultFontSize 14
skinparam nodesep 70
skinparam ranksep 70
hide circle
hide empty members

class RatingsManager {
    +addOrReplaceRating(r: Rating): Rating
    +editRating(index: int, score: float): Rating
    +deleteRating(index: int): Rating
}

class Rating {
    -location: String
    -stall: String
    -food: String
    -score: float
}

class ExpensesManager {
    +addExpense(e: Expense)
    +editExpenseCost(index: int, cost: double): Expense
    +deleteExpense(index: int): Expense
    +getTotalCostBetween(start: LocalDate, end: LocalDate): double
}

class Expense {
    -foodName: String
    -cost: double
    -date: LocalDate
}

class BudgetManager {
    +setBudget(b: Budget)
    +getSpent(e: ExpensesManager, today: LocalDate): double
    +getStatusAfterSpending(e: ExpensesManager, today: LocalDate): String
}

class Budget {
    -amount: double
}

enum BudgetPeriod {
    DAILY
    WEEKLY
    MONTHLY
    +getStartDate(today: LocalDate): LocalDate
}

class Money {
    {static} +parse(text: String, label: String, max: double): double
    {static} +format(amount: double): String
}

RatingsManager *-- "ratings\n*" Rating
ExpensesManager *-- "expenses\n*" Expense
BudgetManager *-- "budget\n0..1" Budget
Budget --> "period\n1" BudgetPeriod

BudgetManager ..> ExpensesManager : asks for\ntotals
Expense ..> Money : checks cost\nwith
Budget ..> Money : checks amount\nwith
@enduml
