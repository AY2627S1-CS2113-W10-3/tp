@startuml
hide footbox
participant ":BudgetBite" as B
participant ":Parser" as P
participant ":RateCommand" as C
participant ":FoodDirectory" as D
participant ":RatingsManager" as M

[-> B : "rate /location PGPR /stall Chicken Rice\n/food Roast Chicken Rice /score 8"
activate B
B -> P : parseCommand(input)
activate P
create C
P -> C : new RateCommand(arguments, ratingsManager, foodDirectory)
P --> B : rateCommand
deactivate P

B -> C : execute()
activate C
C -> C : parseFields()
activate C
C --> C : {location: "PGPR", stall: "Chicken Rice",\nfood: "Roast Chicken Rice", score: "8"}
deactivate C

C -> D : findFoodCourt("PGPR")
activate D
D --> C : foodCourt
deactivate D
note right of C : then foodCourt.findStall(...)\nand stall.findItem(...)

alt a field is missing or repeated, a name is not in the catalogue, or the score is invalid
  C --> B : error message (with the valid names) and usage
else all fields are valid
  create ":Rating" as R
  C -> R : new Rating("PGPR", "Chicken Rice", "Roast Chicken Rice", 8.0)
  C -> M : addRating(rating)
  activate M
  M --> C
  deactivate M
  C --> B : "Rated: Roast Chicken Rice (Chicken Rice, PGPR) - 8.0/10"
end
deactivate C
[<-- B : show response
deactivate B
@enduml
