@startuml
' StorageFile#save writes the three data files, creating the data folder first if needed.
skinparam shadowing false
skinparam defaultFontSize 14
hide footbox

participant ":BudgetBite" as Main
participant ":StorageFile" as S
participant "<<class>>\nEncoder" as En
participant "<<class>>\nFiles" as F

activate Main
Main -> S : save(ratings, expenses, budget)
activate S

S -> En : encodeExpenses(expenses)
activate En
En --> S : lines
deactivate En
S -> S : writeLines(expensesPath, lines)
activate S
S -> F : createDirectories(dataFolder)
activate F
F --> S
deactivate F
S -> F : write(expensesPath, lines)
activate F
F --> S
deactivate F
S --> S
deactivate S

S -> En : encodeRatings(ratings)
activate En
En --> S : lines
deactivate En
S -> S : writeLines(ratingsPath, lines)
activate S
S -> F : createDirectories(dataFolder)
activate F
F --> S
deactivate F
S -> F : write(ratingsPath, lines)
activate F
F --> S
deactivate F
S --> S
deactivate S

S -> S : encodeBudget(budget)
activate S
S --> S : lines
deactivate S
S -> S : writeLines(budgetPath, lines)
activate S
S -> F : createDirectories(dataFolder)
activate F
F --> S
deactivate F
S -> F : write(budgetPath, lines)
activate F
F --> S
deactivate F
S --> S
deactivate S

S --> Main
deactivate S
deactivate Main

note over Main, F
  If a write fails, writeLines throws a BudgetBiteException.
  BudgetBite then adds a warning to the response instead of stopping.
end note
@enduml
